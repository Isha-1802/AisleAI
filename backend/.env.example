PORT=5001
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_here
MONGODB_URI=mongodb://127.0.0.1:27017/aisleai   # or your Atlas SRV string

# --- Optional: AI resilience & 24/7 uptime ---
# Override the Groq models if you like (defaults are sensible).
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Keep-alive to prevent Render free-tier cold starts.
# On Render, RENDER_EXTERNAL_URL is set automatically — no action needed.
# Locally or elsewhere you can set it manually to your public backend URL:
# SELF_URL=https://aisleai-8.onrender.com
